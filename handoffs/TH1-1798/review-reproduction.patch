+// Review-only reproduction; not proposed as a PR change.
+it("review: reserves concurrency slots while workspace context is pending", async () => {
+  let releaseRead: (value: NewChatWorkspaceContext) => void = () => {};
+  const workspace = new Promise<NewChatWorkspaceContext>((resolve) => { releaseRead = resolve; });
+  const harness = createHarness({
+    agents: Object.fromEntries(["a1", "a2", "a3"].map(id => [id, { id, cwd: "/repo", config: {} }])),
+    maxConcurrent: 2,
+    timeline: [],
+    readWorkspaceContext: () => workspace,
+  });
+  for (const id of ["a1", "a2", "a3"]) harness.service.requestFor(id);
+  await new Promise(resolve => setTimeout(resolve, 10));
+  expect(harness.pending).toHaveLength(0);
+  releaseRead({ branch: "feat/review", changedPaths: [], recentCommits: [], moreChangedPaths: 0 });
+  await new Promise(resolve => setTimeout(resolve, 30));
+  console.info("review evidence: maxConcurrent=2; pending provider requests=" + harness.pending.length);
+  harness.service.stop();
+  expect(harness.pending.length).toBeLessThanOrEqual(2);
+});
